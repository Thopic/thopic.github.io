:root{
  --paper:#fbfcfc; --panel:#ffffff; --ink:#111a20; --ink-2:#44555f; --ink-3:#71838d;
  --rule:#dde4e7; --rule-2:#eef2f3; --field:#f2f6f7;
  --teal:#0b7f90; --teal-soft:#e2f1f3;
  --fitc:#3f9c4f; --pe:#d9532f;
  --bin1:#c0392b; --bin2:#e08a16; --bin3:#3f9c4f; --bin4:#2b6cb0;
  --warn:#9a6300; --warn-bg:#fdf3e0; --danger:#b3271c; --danger-bg:#fceeed;
  --ok:#2f7a45;
  --sans:"Archivo","Helvetica Neue",Arial,sans-serif;
  --mono:"Roboto Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#0f1519; --panel:#151d22; --ink:#e7eef1; --ink-2:#a8bac2; --ink-3:#7d9099;
    --rule:#26333a; --rule-2:#1c262c; --field:#1b252b;
    --teal:#4cc3d4; --teal-soft:#10333a;
    --fitc:#6bc47a; --pe:#f0866a;
    --bin1:#e0695c; --bin2:#e0a64a; --bin3:#6bc47a; --bin4:#6aa6e0;
    --warn:#e0b060; --warn-bg:#2b2213; --danger:#f08a80; --danger-bg:#2c1815;
    --ok:#6bc47a;
  }
}
:root[data-theme="dark"]{
  --paper:#0f1519; --panel:#151d22; --ink:#e7eef1; --ink-2:#a8bac2; --ink-3:#7d9099;
  --rule:#26333a; --rule-2:#1c262c; --field:#1b252b;
  --teal:#4cc3d4; --teal-soft:#10333a;
  --fitc:#6bc47a; --pe:#f0866a;
  --bin1:#e0695c; --bin2:#e0a64a; --bin3:#6bc47a; --bin4:#6aa6e0;
  --warn:#e0b060; --warn-bg:#2b2213; --danger:#f08a80; --danger-bg:#2c1815;
  --ok:#6bc47a;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:calc(60px + env(safe-area-inset-top,0px));-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);
  font-size:15.5px;line-height:1.55;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{margin:0;font-weight:600;letter-spacing:-0.015em;line-height:1.2}
p{margin:0 0 .7em}
a{color:var(--teal)}
:focus-visible{outline:2px solid var(--teal);outline-offset:2px;border-radius:3px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* ---------- chrome ---------- */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;background:var(--panel);
  border-bottom:1px solid var(--rule);display:flex;align-items:center;gap:14px;
  padding:9px 18px;flex-wrap:wrap}
.brand{font-weight:700;font-size:15px;letter-spacing:-.02em;white-space:nowrap}
.brand span{color:var(--ink-3);font-weight:400}
.daynav{display:flex;gap:2px;overflow-x:auto;flex:1;min-width:200px;scrollbar-width:thin}
.daynav a{font-size:12.5px;color:var(--ink-2);text-decoration:none;padding:4px 9px;border-radius:5px;
  white-space:nowrap;font-weight:500}
.daynav a:hover{background:var(--field);color:var(--ink)}
.iconbtn{background:var(--field);border:1px solid var(--rule);color:var(--ink-2);border-radius:6px;
  font:inherit;font-size:12.5px;padding:4px 10px;cursor:pointer}
.iconbtn:hover{color:var(--ink);border-color:var(--ink-3)}

.wrap{max-width:1180px;margin:0 auto;padding:0 18px 120px}

/* ---------- hero / clock ---------- */
.hero{padding:34px 0 22px;border-bottom:1px solid var(--rule)}
.hero h1{font-size:clamp(28px,5vw,44px);font-weight:700;letter-spacing:-.03em;max-width:16ch}
.hero .sub{color:var(--ink-2);max-width:62ch;margin-top:12px;font-size:16px}
.clock{margin-top:26px;border:1px solid var(--rule);border-radius:10px;background:var(--panel);overflow:hidden}
.clock-head{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;padding:14px 16px;
  border-bottom:1px solid var(--rule-2)}
.timeline{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0}
.tl{padding:13px 16px;border-right:1px solid var(--rule-2);border-top:1px solid var(--rule-2)}
.tl:last-child{border-right:none}
.tl .when{font-family:var(--mono);font-size:15px;font-weight:500;color:var(--teal)}
.tl .what{font-size:13px;color:var(--ink-2);margin-top:2px}
.tl .gap{font-size:11.5px;color:var(--ink-3);font-family:var(--mono);margin-top:4px}

/* ---------- sections ---------- */
section{padding:38px 0 8px;border-bottom:1px solid var(--rule)}
.sechead{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:6px}
.sechead h2{font-size:23px}
.sechead .tag{font-family:var(--mono);font-size:12px;color:var(--ink-3);border:1px solid var(--rule);
  padding:1px 7px;border-radius:20px}
.lede{color:var(--ink-2);max-width:72ch;margin-bottom:18px}

.panel{background:var(--panel);border:1px solid var(--rule);border-radius:10px;padding:16px;margin:16px 0}
.panel h3{font-size:15px;margin-bottom:10px}
.grid{display:grid;gap:14px 20px;grid-template-columns:repeat(auto-fit,minmax(178px,1fr))}

label.f{display:block;font-size:12.5px;color:var(--ink-2);font-weight:500}
label.f .hint{display:block;color:var(--ink-3);font-weight:400;font-size:11.5px;margin-top:1px}
input[type=number],input[type=text],input[type=datetime-local],select{
  width:100%;margin-top:5px;background:var(--field);border:1px solid var(--rule);color:var(--ink);
  font-family:var(--mono);font-size:14px;padding:6px 8px;border-radius:6px}
input[type=number]:focus,input[type=text]:focus,select:focus{border-color:var(--teal);outline:none;
  box-shadow:0 0 0 2px var(--teal-soft)}
input.mini{width:82px;margin-top:0;padding:3px 6px;font-size:13px;text-align:right}
input.mini.wide{width:108px}
input[type=checkbox]{accent-color:var(--teal);width:15px;height:15px}

/* ---------- tables ---------- */
.tscroll{overflow-x:auto;border:1px solid var(--rule);border-radius:10px;background:var(--panel);margin:14px 0}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{padding:7px 10px;text-align:right;white-space:nowrap;border-bottom:1px solid var(--rule-2)}
th{background:var(--panel);position:sticky;top:0;font-size:11.5px;font-weight:600;color:var(--ink-2);
  letter-spacing:.01em;border-bottom:1px solid var(--rule);z-index:1}
th.l,td.l{text-align:left}
td{font-family:var(--mono);font-variant-numeric:tabular-nums}
td.l{font-family:var(--sans)}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:var(--rule-2)}
tfoot td{font-weight:600;border-top:1px solid var(--rule);background:var(--field)}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}
.muted{color:var(--ink-3)}
.warn{color:var(--warn)}
.bad{color:var(--danger);font-weight:500}
.good{color:var(--ok)}
td.warncell{background:var(--warn-bg)}
td.badcell{background:var(--danger-bg)}

/* ---------- steps ---------- */
ol.steps{list-style:none;counter-reset:s;padding:0;margin:14px 0}
ol.steps>li{counter-increment:s;position:relative;padding:0 0 14px 42px;margin:0}
ol.steps>li::before{content:counter(s);position:absolute;left:0;top:1px;width:26px;height:26px;
  border-radius:50%;border:1px solid var(--rule);display:grid;place-items:center;
  font-family:var(--mono);font-size:12px;color:var(--ink-2);background:var(--panel)}
ol.steps>li::after{content:"";position:absolute;left:13px;top:29px;bottom:0;width:1px;background:var(--rule)}
ol.steps>li:last-child::after{display:none}
ol.steps .t{font-weight:600}
ol.steps ul{margin:6px 0 0;padding-left:18px;color:var(--ink-2)}
ol.steps ul li{margin:3px 0}
.callout{border-left:3px solid var(--teal);background:var(--teal-soft);padding:9px 13px;border-radius:0 7px 7px 0;
  margin:10px 0;font-size:14px}
.callout.w{border-color:var(--warn);background:var(--warn-bg)}
.callout.d{border-color:var(--danger);background:var(--danger-bg)}
.callout b{font-weight:600}
.dark-note{display:inline-block;font-size:12px;font-weight:600;color:var(--panel);background:var(--ink);
  padding:1px 8px;border-radius:20px}

/* ---------- misc ---------- */
.chips{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}
.chip{font-family:var(--mono);font-size:12px;padding:2px 9px;border-radius:20px;border:1px solid var(--rule);color:var(--ink-2)}
.chip.b1{border-color:var(--bin1);color:var(--bin1)}
.chip.b2{border-color:var(--bin2);color:var(--bin2)}
.chip.b3{border-color:var(--bin3);color:var(--bin3)}
.chip.b4{border-color:var(--bin4);color:var(--bin4)}
.chip.fitc{border-color:var(--fitc);color:var(--fitc)}
.chip.pe{border-color:var(--pe);color:var(--pe)}
.checkrow{display:flex;align-items:flex-start;gap:10px;padding:6px 0;border-bottom:1px solid var(--rule-2)}
.checkrow:last-child{border-bottom:none}
.checkrow .qty{font-family:var(--mono);font-size:13px;color:var(--teal);white-space:nowrap;min-width:104px;text-align:right}
.checkrow .nm{flex:1;font-size:14px}
.checkrow .nm small{display:block;color:var(--ink-3);font-size:12px}
.checkrow input:checked + .nm{text-decoration:line-through;color:var(--ink-3)}
.twocol{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px}
.kv{display:flex;justify-content:space-between;gap:12px;padding:5px 0;border-bottom:1px dotted var(--rule);font-size:13.5px}
.kv:last-child{border-bottom:none}
.kv .v{font-family:var(--mono);font-weight:500}
details{margin:10px 0}
summary{cursor:pointer;font-size:13.5px;color:var(--teal);font-weight:500}
.formula{font-family:var(--mono);font-size:13px;background:var(--field);padding:9px 11px;border-radius:7px;
  overflow-x:auto;margin:8px 0;color:var(--ink-2)}
footer{padding:30px 0;color:var(--ink-3);font-size:13px}
.btnrow{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
button.act{background:var(--teal);color:#fff;border:none;border-radius:6px;font:inherit;font-size:13px;
  font-weight:500;padding:6px 13px;cursor:pointer}
button.act.ghost{background:transparent;color:var(--teal);border:1px solid var(--teal)}
button.act:hover{filter:brightness(1.08)}
:root[data-theme="dark"] button.act{color:#06161a}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) button.act{color:#06161a}}

@media print{
  .topbar,.btnrow,footer .noprint{display:none}
  body{font-size:10.5pt;background:#fff;color:#000}
  section{page-break-inside:auto;border-bottom:1px solid #999}
  .tscroll{overflow:visible;border:1px solid #999}
  th{position:static}
  .panel{border:1px solid #999}
}

/* ---------- collapsible block ---------- */
details.box{border:1px solid var(--rule);border-radius:10px;background:var(--panel);margin:16px 0}
details.box>summary{padding:12px 16px;font-weight:600;font-size:14px;color:var(--ink);
  cursor:pointer;display:flex;align-items:center;gap:8px;list-style:none}
details.box>summary::-webkit-details-marker{display:none}
details.box>summary::before{content:"\25B8";color:var(--ink-3);font-size:11px}
details.box[open]>summary::before{content:"\25BE"}
details.box[open]>summary{border-bottom:1px solid var(--rule-2)}
details.box .inner{padding:0 16px 8px}
details.box .inner>.panel{border:none;border-radius:0;padding:14px 0;margin:0;
  border-top:1px solid var(--rule-2)}
details.box .inner>.panel:first-child{border-top:none}

/* ---------- grouped rows inside a table ---------- */
tr.sub td{background:var(--field);font-family:var(--sans);font-weight:600;font-size:11.5px;
  letter-spacing:.03em;color:var(--ink-2);border-top:1px solid var(--rule);
  border-bottom:1px solid var(--rule)}
tbody tr.sub:hover td{background:var(--field)}

/* ---------- compact step list inside a panel ---------- */
ol.steps.tight>li{padding-bottom:9px;font-size:14px}
ol.steps.tight>li::before{width:22px;height:22px;font-size:11px}
ol.steps.tight>li{padding-left:34px}
ol.steps.tight>li::after{left:11px;top:25px}

/* ---------- per-culture rows ---------- */
.cellrow{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:9px 0;
  border-bottom:1px solid var(--rule-2)}
.cellrow:last-child{border-bottom:none}
.cellrow .nm{font-weight:600;font-size:14px;min-width:150px}
.cellrow .od{display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--ink-2)}
.cellrow .od input{width:76px;margin:0;padding:4px 7px;text-align:right}
.cellrow .out{font-family:var(--mono);font-size:13px;color:var(--ink-2);flex:1}
.cellrow .out b{color:var(--teal);font-weight:500}
.cellrow .out.wait{color:var(--ink-3)}
.note{font-size:13px;margin-top:10px}
.note.bad{color:var(--danger)}
.note.warn{color:var(--warn)}
